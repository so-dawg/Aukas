{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "test": "jest --forceExit --detectOpenHandles",
    "db:migrate": "export $(grep -v '^#' ../.env | xargs) && npx sequelize-cli db:migrate",
    "db:seed": "export $(grep -v '^#' ../.env | xargs) && npx sequelize-cli db:seed:all",
    "db:undo": "export $(grep -v '^#' ../.env | xargs) && npx sequelize-cli db:migrate:undo",
    "db:backup": "export $(grep -v '^#' ../.env | xargs) && mkdir -p ../backups && pg_dump $(echo $DATABASE_URL) > ../backups/aukas_$(date +%Y%m%d_%H%M%S).sql"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "nodemailer": "^6.10.1",
    "pg": "^8.20.0",
    "sequelize": "^6.37.8",
    "sequelize-cli": "^6.6.5"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.1.0"
  }
}
